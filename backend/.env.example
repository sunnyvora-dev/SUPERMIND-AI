# Database Configuration (PostgreSQL / SQLite fallback for zero-dependency local dev)
DATABASE_URL="file:./dev.db"

# JWT Secret Configuration
JWT_SECRET="supermind_local_dev_jwt_secret_key_2026_super_secure"
JWT_EXPIRES_IN="7d"



# Server Port
PORT=3000

# AI Proxy / Gateway Configuration (ScaleMax Unified Gateway)
BASE_URL="https://api.scalemax.pro/token/v1"
AI_BASE_URL="https://api.scalemax.pro/token/v1"

# ScaleMax Unified Token (Powers DeepSeek, Kimi, Gemini, and OpenAI simultaneously)
# ScaleMax keys typically start with 'sm_live_', 'sm_dev_', or 'sm_trial_'
SCALEMAX_API_KEY="sm_live_your_scalemax_api_key_here"

# Individual Provider Overrides (Optional fallback if direct keys are used)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
KIMI_API_KEY=""

# Redis Configuration (Optional)
REDIS_URL="redis://localhost:6379"

# Environment
NODE_ENV="development"
